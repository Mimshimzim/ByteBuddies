# Copy to .env (never commit .env). Compose interpolation values only; no secrets.
COMPOSE_PROJECT_NAME=bytebuddies-review
# Immutable release tag used for rollback (e.g. a git short SHA or date).
BYTEBUDDIES_IMAGE_TAG=dev
# Host port published for the web service (container port is 3000).
BYTEBUDDIES_HOST_PORT=8080
